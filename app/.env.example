# Only server variables contain credentials. Never use NEXT_PUBLIC_* for secrets.
GLM_API_KEY=
GLM_MODEL=glm-4.5-air
GLM_API_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
AI_ENABLED=0
# Daily limits use UTC days (08:00 reset in Asia/Shanghai).
AI_DAILY_CALLS=0
AI_DAILY_TOKENS=0
AI_MAX_CONCURRENCY=0
AI_MAX_OUTPUT_TOKENS=512
# Absolute persistent path outside deployment releases in production.
AI_QUOTA_PATH=.runtime/ai-quota.json
APP_ORIGIN=
TRUST_PROXY=0
NEXT_PUBLIC_BASE_PATH=/SonoScope
