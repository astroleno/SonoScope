{
  "name": "sonoscope-test",
  "version": "1.0.0",
  "description": "SonoScope Test Suite",
  "scripts": {
    "test": "vitest run",
    "test:legacy": "vitest run --config legacy.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:phase1": "vitest run test/phase1/*",
    "test:phase2": "vitest run test/phase2/*",
    "test:phase2-5": "vitest run test/phase2-5/*",
    "test:phase2-6": "vitest run test/phase2-6/*",
    "test:report": "tsx test/run-tests.ts",
    "test:all": "npm run test:report"
  },
  "devDependencies": {
    "@sonoscope/core": "workspace:*",
    "@sonoscope/sdk": "workspace:*",
    "@sonoscope/danmu-pipeline": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "vitest": "5.0.4",
    "jsdom": "^25.0.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "type": "module"
}
