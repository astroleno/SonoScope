{
  "name": "sonoscope",
  "version": "1.0.0",
  "description": "基于浏览器的实时音乐可视化与弹幕引擎",
  "private": true,
  "workspaces": [
    "app",
    "packages/*",
    "test"
  ],
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @sonoscope/app dev",
    "build:packages": "pnpm --filter './packages/**' build",
    "build": "pnpm prepare:assets && pnpm -r build",
    "test": "pnpm build:packages && pnpm --filter sonoscope-test test",
    "lint": "eslint app packages test/launch test/audio-feature-enhancement.test.ts test/phase2-5 scripts/*.mjs",
    "type-check": "pnpm build:packages && pnpm -r --if-present type-check",
    "check": "pnpm build:packages && pnpm lint && pnpm --filter sonoscope-test test && pnpm -r --if-present type-check && pnpm prepare:assets && pnpm --filter @sonoscope/app build && pnpm package:release && pnpm smoke:release",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "benchmark:ai": "node scripts/ai-benchmark.mjs",
    "package:release": "node scripts/package-release.mjs",
    "smoke:release": "node scripts/smoke-release.mjs",
    "audit:production": "pnpm audit --prod --registry=https://registry.npmjs.org",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "ajv@8.17.1": "8.18.0",
      "fast-uri@3": "3.1.9",
      "picomatch@4": "4.0.4",
      "form-data@4.0.4": "4.0.6",
      "browserslist@4.26.2": "4.28.7",
      "baseline-browser-mapping@2.8.6": "2.11.0",
      "source-map-js@1.2.1": "1.2.2"
    }
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "keywords": [
    "audio",
    "visualization",
    "music",
    "p5js",
    "web-audio",
    "real-time",
    "accessibility"
  ],
  "author": "SonoScope Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/sonoscope.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/sonoscope/issues"
  },
  "homepage": "https://sonoscope.dev"
}
